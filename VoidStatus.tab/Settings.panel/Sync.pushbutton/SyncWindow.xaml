<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Void Status — Sync from link"
        Width="560"
        Height="560"
        MinWidth="420"
        MinHeight="400"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Background="#F4F4F4">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="3" Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock x:Name="introTitle" Text="Linked model" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4"/>
                <TextBlock x:Name="introText" Text="Choose a loaded Revit or IFC link. Unique Approved by / Rejected by / Pending by codes in that model are listed below. Importing merges those codes into matching openings here (STR stays if the link adds ARC → STR, ARC). Drawn by and other parameters are not changed." FontSize="11" Foreground="#666666" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <ComboBox x:Name="linkCombo" Height="26" SelectionChanged="link_changed"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="White" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="3" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Statuses to import" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="disciplinesPanel"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <TextBlock x:Name="statusText" Grid.Row="2" FontSize="12" Foreground="#444444" TextWrapping="Wrap" Margin="0,0,0,12"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="importButton" Content="Import" Width="110" Height="32" Margin="0,0,8,0" IsDefault="True" Click="import_click"/>
            <Button x:Name="closeButton" Content="Close" Width="110" Height="32" IsCancel="True" Click="close_click"/>
        </StackPanel>
    </Grid>
</Window>
