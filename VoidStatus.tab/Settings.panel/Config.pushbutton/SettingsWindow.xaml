<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Void Status — Config"
        Width="680"
        Height="760"
        MinWidth="560"
        MinHeight="520"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Background="#F4F4F4">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
            <StackPanel>

                <Border Background="White" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="3" Padding="12" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Your profile" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4"/>
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="Discipline is written into Approved by, Pending by and Rejected by for openings you stamp in this model. You can use a different code in another file. Name stays on this workstation." FontSize="11" Foreground="#666666" Margin="0,0,0,10" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Name" VerticalAlignment="Center" Margin="0,0,8,8"/>
                        <TextBox x:Name="nameBox" Grid.Row="2" Grid.Column="1" MinHeight="32" Margin="0,0,0,8" Padding="6,4" VerticalContentAlignment="Center"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Discipline" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="disciplineCombo" Grid.Row="3" Grid.Column="1" MinHeight="32" Padding="4,4" VerticalContentAlignment="Center" IsEditable="True"/>
                    </Grid>
                </Border>

                <Border Background="White" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="3" Padding="12" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="180"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="This model (shared with colleagues)" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4"/>
                        <TextBlock Grid.Row="1" Text="Discipline codes available in this project. Combined codes such as HVAC &amp; PLBG are one value." FontSize="11" Foreground="#666666" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="2" Text="Codes" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                        <DataGrid x:Name="disciplineGrid"
                                  Grid.Row="3"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="True"
                                  CanUserDeleteRows="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  EnableRowVirtualization="False"
                                  Background="White"
                                  BorderBrush="#CCCCCC"
                                  RowHeaderWidth="0"
                                  AlternatingRowBackground="#FAFAFA"
                                  SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="140"/>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Grid.Row="4" Text="Click the empty row to add a code. Select a row and press Delete to remove it." FontSize="11" Foreground="#888888" Margin="0,6,0,12"/>

                        <TextBlock Grid.Row="5" Text="Categories for Ensure parameters" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                        <WrapPanel x:Name="categoriesPanel" Grid.Row="6" Margin="0,0,0,12"/>

                        <Grid Grid.Row="7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12" Foreground="#444444"
                                       Text="Add or repair status parameters (including Chat Log) on the selected categories. Incomplete bindings are expanded."/>
                            <Button x:Name="ensureParamsButton" Grid.Column="1" Content="Ensure parameters" Width="150" Height="28" Margin="12,0,0,0" Click="ensure_params_click"/>
                        </Grid>
                    </Grid>
                </Border>

                <Expander x:Name="advancedExpander" Header="Advanced" IsExpanded="False" Margin="0,0,0,4">
                    <Border Background="White" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="3" Padding="12" Margin="0,8,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="200"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Value separator" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="separatorBox" Grid.Column="1" MinHeight="32" Padding="6,4" VerticalContentAlignment="Center"/>
                            </Grid>
                            <TextBlock Grid.Row="1" Text="Parameter mapping. Leave the defaults unless this project uses different names or GUIDs." FontSize="11" Foreground="#666666" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <DataGrid x:Name="parameterGrid"
                                      Grid.Row="2"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      EnableRowVirtualization="False"
                                      Background="White"
                                      BorderBrush="#CCCCCC"
                                      RowHeaderWidth="0"
                                      AlternatingRowBackground="#FAFAFA">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Parameter" Binding="{Binding Key}" IsReadOnly="True" Width="120"/>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="140"/>
                                    <DataGridTextColumn Header="GUID" Binding="{Binding Guid}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                <Button x:Name="importButton" Content="Import…" Width="100" Height="28" Margin="0,0,8,0" Click="import_click"/>
                                <Button x:Name="exportButton" Content="Export…" Width="100" Height="28" Margin="0,0,8,0" Click="export_click"/>
                                <Button x:Name="resetButton" Content="Restore defaults" Width="130" Height="28" Click="reset_click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Expander>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="saveButton" Content="Save" Width="110" Height="32" Margin="0,0,8,0" IsDefault="True" Click="save_click"/>
            <Button x:Name="closeButton" Content="Close" Width="110" Height="32" IsCancel="True" Click="close_click"/>
        </StackPanel>
    </Grid>
</Window>
